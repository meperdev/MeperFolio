---
import { render, type CollectionEntry } from 'astro:content';
import type { Locale } from '../lib/i18n';
import { tagHue } from '../lib/tags';

interface Props {
  locale: Locale;
  index: string;
  title: string;
  presentLabel: string;
  entries: CollectionEntry<'experience'>[];
  hidden?: boolean;
}

const { locale, index, title, presentLabel, entries, hidden } = Astro.props;

const rendered = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  })),
);

function period(start: string, end: string | undefined): string {
  return end ? `${start} — ${end}` : `${start} — ${presentLabel}`;
}
---

{entries.length > 0 && (
  <section data-locale={locale} class="py-12 lg:py-section" hidden={hidden || undefined}>
    <div class="px-6">
      <div class="max-w-2xl">
        <p class="section-eyebrow" data-reveal>{index}</p>
        <h2 class="mt-4 text-display-md text-ink" data-reveal>
          {title}
        </h2>
        <ol class="mt-8">
          {
            rendered.map(({ entry, Content }) => (
              <li class="group flex gap-6" data-reveal>
                <div class="flex flex-col items-center">
                  <span class="timeline-dot mt-2 h-2 w-2 shrink-0 rounded-full bg-primary"></span>
                  <span class="timeline-line w-px flex-1"></span>
                </div>
                <div class="pb-10 group-last:pb-3">
                  <h3 class="text-card-title text-ink">
                    {entry.data.role}
                  </h3>
                  <p class="mt-1.5 text-sm font-medium text-ink-muted">{entry.data.company}</p>
                  <p class="mt-1 font-mono text-xs tracking-[0.04em] tabular-nums text-ink-subtle">
                    {period(entry.data.start, entry.data.end)}
                  </p>
                  <div class="rich-text mt-4 text-ink-muted">
                    <Content />
                  </div>
                  <ul class="mt-5 flex flex-wrap gap-2">
                    {entry.data.tags.map((tag) => (
                      <li class="tag" style={`--tag-accent: ${tagHue(tag)}`}>
                        {tag}
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>
)}
